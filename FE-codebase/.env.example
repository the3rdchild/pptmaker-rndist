NEXT_PUBLIC_API_URL=http://localhost:8080

# S3-compatible storage for templates + elements.
# Server-only — do NOT add a NEXT_PUBLIC_ prefix.
#
# If the bucket name contains dots, use the path-style form for both
# CDN_ENDPOINT and CDN_PUBLIC_URL — the virtual-host form
# (bucket.region.provider.com) fails TLS validation against wildcard certs.
#   CDN_ENDPOINT=https://<region>.digitaloceanspaces.com
#   CDN_PUBLIC_URL=https://<region>.digitaloceanspaces.com/<bucket>
CDN_BUCKET_NAME=
CDN_ENDPOINT=
CDN_PUBLIC_URL=
CDN_ACCESS_KEY_ID=
CDN_SECRET_ACCESS_KEY=
CDN_REGION=
# true for AWS S3 / DO Spaces (objects are private unless uploaded with a
# public-read ACL). Leave unset for R2 / MinIO.
S3_USE_OBJECT_ACL=

# Serve theme/element images from this origin instead of straight from the CDN.
# Defaults to on, and required while the bucket has no CORS policy — canvas
# export taints without it. Set "false" once bucket CORS is configured.
TEMPLATE_ASSETS_PROXY=

# Kimi — theme-choice, auto-label (page + theme) and visual-review calls.
# Server-only — do NOT add a NEXT_PUBLIC_ prefix. sk-kimi-* subscription keys
# only work on the default api.kimi.com/coding endpoint.
KIMI_API_KEY=
KIMI_BASE_URL=
KIMI_MODEL=

# OpenAI — the "GPT-4o (vision)" and "GPT-5.3 Codex (vision)" presets.
# Server-only — do NOT add a NEXT_PUBLIC_ prefix. The gpt-*-codex models are
# served ONLY on /responses (they 404 on /chat/completions); the provider
# layer switches endpoints per preset, so one key covers both.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_CODEX_MODEL=gpt-5.3-codex

# Zhipu GLM — the "GLM-4.6" and "GLM-4.5 Flash" presets (one key, two
# endpoints). DeepInfra — the Qwen/Gemma/Llama vision presets + DeepSeek V3.1.
ZHIPU_API_KEY=
DEEPINFRA_API_KEY=

# Stock photo search ("Fill with stock photo" in the image toolbar).
# Server-only — do NOT add a NEXT_PUBLIC_ prefix. Set one or more; the first
# key set becomes the default provider. Attribution is captured per photo.
#   Pexels:   https://www.pexels.com/api/
#   Unsplash: https://unsplash.com/developers — demo key is capped at 50
#             requests/hour; apply for Production access before real use.
#             API Guidelines require apps to ping download_location when a
#             photo is used — handled by /api/stock-images/track-download.
#   Pixabay:  https://pixabay.com/api/docs/
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=
