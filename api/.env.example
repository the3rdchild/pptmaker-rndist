NODE_ENV=development
DATABASE_URL=
PORT=8080
ORIGIN=*

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# S3-compatible CDN (Cloudflare R2 / DO Spaces / MinIO).
# Used for image uploads (pm8b). Leave empty to disable uploads.
CDN_BUCKET_NAME=
CDN_ENDPOINT=
CDN_PUBLIC_URL=
CDN_ACCESS_KEY_ID=
CDN_SECRET_ACCESS_KEY=
CDN_REGION=us-east-1
# true for AWS S3 / DO Spaces (object ACL support). Leave unset for R2 / MinIO.
S3_USE_OBJECT_ACL=

SERVICE_URL=http://localhost:8080

# DeepInfra (OpenAI-compatible) — used by the Python worker, but kept here
# for shared documentation. The worker reads DEEPINFRA_* from its own .env.
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V3.1-Terminus

# BullMQ queue names (must match worker .env)
PPT_QUEUE_NAME=PPT_QUEUE
PPT_JOB_NAME=PROCESS_PPT
