DATABASE_URL=
REDIS_URL=redis://localhost:6379

PPT_QUEUE_NAME=PPT_QUEUE
PPT_JOB_NAME=PROCESS_PPT

# DeepInfra (OpenAI-compatible)
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V3.1-Terminus
DEEPINFRA_IMAGE_MODEL=black-forest-labs/FLUX-2-klein-4b

# Default text-LLM provider — any id registered in PROVIDER_CONFIGS
# (core/configs/env.py): deepinfra (default), gpt, codex, glm, glm-flash,
# qwen-vl, gemma-vl, llama-vl, kimi. Only affects llm_client.py
# (deck/outline/agent/writing generation) — image generation always uses
# DeepInfra above, regardless of this setting. Individual requests override it
# per call via the `model` param (homepage picker, chat model switcher).
LLM_PROVIDER=deepinfra

# OpenAI — provider "gpt" (chat/completions) and "codex" (responses API).
# The gpt-*-codex models are served ONLY on /responses; llm_client picks the
# endpoint per provider, so one key covers both.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_CODEX_MODEL=gpt-5.3-codex

# Zhipu GLM (OpenAI-compatible) — providers "glm" (coding endpoint) and
# "glm-flash" (BigModel pay-per-token). One key serves both.
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.5-flash

# Kimi (Moonshot) coding endpoint — sk-kimi-* subscription keys only work on
# api.kimi.com/coding with a recognized coding-agent User-Agent (sent by
# llm_client), and reject any temperature other than 1.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=kimi-k2.6

# SSE channel prefix (published by worker, consumed by API SSE route)
STREAM_CHANNEL_PREFIX=ppt:stream
