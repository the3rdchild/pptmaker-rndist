DATABASE_URL=
REDIS_URL=redis://localhost:6379

PPT_QUEUE_NAME=PPT_QUEUE
PPT_JOB_NAME=PROCESS_PPT

# DeepInfra (OpenAI-compatible)
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V3.1-Terminus

# Default text-LLM provider — any id registered in PROVIDER_CONFIGS
# (core/configs/env.py): gpt-luna (default), gpt-terra, gpt-sol, deepinfra,
# qwen-vl, gemma-vl, llama-vl. Individual requests override it via `model`.
LLM_PROVIDER=gpt-luna

# CommandCode — one key for all three GPT-5.6 tiers.
COMMANDCODE_API_KEY=
COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1
COMMANDCODE_LUNA_MODEL=gpt-5.6-luna
COMMANDCODE_TERRA_MODEL=gpt-5.6-terra
COMMANDCODE_SOL_MODEL=gpt-5.6-sol

# Runware — image generation tiers (cheap/mid/premium) resolve server-side.
RUNWARE_API_KEY=
RUNWARE_BASE_URL=https://api.runware.ai/v1
RUNWARE_IMAGE_MODEL=runware-mid

# SSE channel prefix (published by worker, consumed by API SSE route)
STREAM_CHANNEL_PREFIX=ppt:stream
