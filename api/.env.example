NODE_ENV=development
DATABASE_URL=
PORT=8080
ORIGIN=*

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

SERVICE_URL=http://localhost:8080

# DeepInfra (OpenAI-compatible) — used by the Python worker, but kept here
# for shared documentation. The worker reads DEEPINFRA_* from its own .env.
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V3.1-Terminus

# BullMQ queue names (must match worker .env)
PPT_QUEUE_NAME=PPT_QUEUE
PPT_JOB_NAME=PROCESS_PPT
