DATABASE_URL=
REDIS_URL=redis://localhost:6379

PPT_QUEUE_NAME=PPT_QUEUE
PPT_JOB_NAME=PROCESS_PPT

# DeepInfra (OpenAI-compatible)
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V3.1-Terminus
DEEPINFRA_IMAGE_MODEL=black-forest-labs/FLUX-2-klein-4b

# Text-LLM provider switch: "deepinfra" (default) or "openai". Only affects
# llm_client.py (deck/outline/agent/writing generation) — image generation
# always uses DeepInfra above, regardless of this setting.
LLM_PROVIDER=deepinfra
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# SSE channel prefix (published by worker, consumed by API SSE route)
STREAM_CHANNEL_PREFIX=ppt:stream
